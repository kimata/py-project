image: {{ vars.registry }}/local-ubuntu:{{ vars.ubuntu_tag }}

variables:
    UV_LINK_MODE: copy
    UV_CACHE_DIR: .uv-cache
    PYRIGHT_PYTHON_FORCE_VERSION: latest
    UV_HTTP_TIMEOUT: "120"

    UV_EXTRA_INDEX_URL: "http://proxy:3141/simple/"
    UV_INSECURE_HOST: "proxy"

default:
    before_script:
        - echo $CI_REGISTRY_PASSWORD | docker login -u $CI_REGISTRY_USER --password-stdin $CI_REGISTRY

stages:
    - generate-tag
    - build
    - test
    - tag-latest
    - deploy
    - renovate

generate-tag:
    stage: generate-tag
    script:
        # NOTE: タグはイメージ内容を決める入力 (アプリ + clone する設定リポジトリ群) から
        # 決定論的に生成する。日時部分は入力の最終コミット日時 (人間向け)、末尾の入力ハッシュが
        # 一意性を担保する。内容が変わらない限りタグは同一になり、変わったら必ずタグも変わるため、
        # 設定だけの変更でも kubectl set image が確実にロールアウトする。
        - |
            INPUT_SHAS="${CI_COMMIT_SHA}"
            NEWEST_EPOCH=$(date -d "${CI_COMMIT_TIMESTAMP}" +%s)
{%- for url in project.ci.input_repo_urls() %}
            INPUT_REPO="{{ url }}"
            git clone --quiet --depth 1 "${INPUT_REPO}" .input-repo-{{ loop.index }}
            INPUT_SHAS="${INPUT_SHAS} $(git -C .input-repo-{{ loop.index }} rev-parse HEAD)"
            REPO_EPOCH=$(git -C .input-repo-{{ loop.index }} log -1 --format=%ct)
            if [ "${REPO_EPOCH}" -gt "${NEWEST_EPOCH}" ]; then NEWEST_EPOCH="${REPO_EPOCH}"; fi
            rm -rf .input-repo-{{ loop.index }}
{%- endfor %}
            INPUT_HASH=$(echo "${INPUT_SHAS}" | sha1sum | cut -c1-7)
            TAG_DATE=$(date -d "@${NEWEST_EPOCH}" +%y%m%d-%H%M)
            echo "TAG=${TAG_DATE}_${CI_COMMIT_SHORT_SHA}_i${INPUT_HASH}" > tag.env
            echo "IMAGE_BUILD_DATE=$(date -d "@${NEWEST_EPOCH}" --iso-8601=seconds)" >> tag.env
            cat tag.env
    artifacts:
        reports:
            dotenv: tag.env
        expire_in: 1 hour
{%- if project.ci.frontend %}

build-react:
    stage: build

    needs: []

    image: {{ vars.ci_node_image }}

    variables:
        # NOTE: vite 等がバンドルに埋め込むビルド日時を決定論的にする
        # (wall-clock だと内容が変わらなくてもイメージが毎ビルド変化してしまう)
        IMAGE_BUILD_DATE: ${CI_COMMIT_TIMESTAMP}

    before_script: []

    script:
        - cd frontend
        - npm ci --cache .npm --prefer-offline --no-audit --no-fund
        - npm run {{ project.ci.npm_build_script }}
    artifacts:
        paths:
            - frontend/dist/
    cache:
        - key:
              files:
                  - frontend/package-lock.json
          fallback_keys:
              - npm-cache-${CI_PROJECT_ID}
          paths:
              - .npm/
{%- endif %}

build-image:
    stage: build

    needs:
        - generate-tag
{%- if project.ci.frontend %}
        - build-react
{%- endif %}
{%- for job in project.ci.extra_build_needs %}
        - {{ job }}
{%- endfor %}

    variables:
        BUILDER: builder-${CI_PROJECT_NAME}

    script:
        - 'echo "Building: ${CI_REGISTRY_IMAGE}:${TAG}"'
{% for line in project.ci.config_script %}
{%- if "\n" in line %}
        - >
{{ line | indent(12, true) }}
{%- else %}
        - {{ line }}
{%- endif %}
{%- endfor %}

        - docker buildx create --driver docker-container --name ${BUILDER} --use --config /etc/buildkitd.toml
        - docker buildx use ${BUILDER}
        - docker buildx inspect --bootstrap
        - >
            docker buildx build
            --provenance=false
            --progress=plain
            --platform {{ project.ci.build_platforms }}
            --cache-from type=registry,ref=${CI_REGISTRY_IMAGE}:cache
            --cache-from type=registry,ref=${CI_REGISTRY_IMAGE}:latest
            --cache-to type=inline
            --cache-to type=registry,ref=${CI_REGISTRY_IMAGE}:cache,mode=max
            --build-arg IMAGE_BUILD_DATE=${IMAGE_BUILD_DATE}
{%- for arg in project.ci.extra_build_args %}
            {{ arg }}
{%- endfor %}
            --tag ${CI_REGISTRY_IMAGE}:${TAG}
            --push .

test-typecheck:
    stage: test
{%- if project.ci.test_needs %}

    needs:
{%- for job in project.ci.test_needs %}
        - {{ job }}
{%- endfor %}
{%- else %}

    needs: []
{%- endif %}
{%- if project.ci.typecheck_allow_failure %}

    # NOTE: 型チェックは未整備のため段階導入 (失敗してもパイプラインは止めない)
    allow_failure: true
{%- endif %}

    before_script:
        - uv sync --locked --no-editable

    script:
        - uv run python -m pyright{% if project.ci.pyright_target %} {{ project.ci.pyright_target }}{% endif %}
        - uv run mypy {{ project.ci.typecheck_target }}
{%- if project.ci.ty %}
        - uv run ty check {{ project.ci.typecheck_target }}
{%- endif %}

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          paths:
              - ${UV_CACHE_DIR}
              - .mypy_cache/

test-pytest:
    stage: test
{%- if project.ci.test_needs %}

    needs:
{%- for job in project.ci.test_needs %}
        - {{ job }}
{%- endfor %}
{%- else %}

    needs: []
{%- endif %}

    before_script:
        - uv sync --locked --no-editable

    script:
{%- if project.ci.pytest_config_script %}
{%- for line in project.ci.config_script %}
        - {{ line }}
{%- endfor %}
{%- endif %}
{%- for cmd in project.ci.pytest_pre %}
        - {{ cmd }}
{%- endfor %}
        - uv run pytest{% if project.ci.pytest_args %} {{ project.ci.pytest_args }}{% endif %}

    coverage: '/TOTAL.*\s+(\d+%)/'

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          paths:
              - ${UV_CACHE_DIR}

    artifacts:
        when: always
        paths:
            - reports/**
{%- for path in project.ci.extra_artifacts %}
            - {{ path }}
{%- endfor %}
        reports:
            junit: reports/junit-report.xml
            coverage_report:
                coverage_format: cobertura
                path: reports/coverage.xml
{%- if project.ci.webui_run %}

test-webui:
    stage: test
    needs:
        - generate-tag
        - build-image

    script:
        # NOTE: テストに失敗するとテスト用のコンテナが残るので削除する
        - >
            docker ps --filter "label=job=${CI_JOB_NAME}" | grep hours |
            cut -d " " -f1 |
            while read id; do docker stop -t 5 $id; done || true

        - uv sync --locked --no-editable
{% for line in project.ci.webui_run %}
{%- if "\n" in line %}
        - >
{{ line | indent(12, true) }}
{%- else %}
        - {{ line }}
{%- endif %}
{%- endfor %}

        - uv run playwright install --with-deps chromium

        - >
            APP_PORT=$(docker port "${CI_JOB_NAME}-${CI_JOB_ID}" 5000 | cut -d: -f2)
        - >
            DOCKER_GATEWAY=$(docker network inspect bridge --format="{% raw %}{{range .IPAM.Config}}{{.Gateway}}{{end}}{% endraw %}")
        - >
            timeout 60 bash -c "until curl --fail --connect-timeout 10 --max-time 15
            \"http://${DOCKER_GATEWAY}:${APP_PORT}{{ project.ci.webui_health_path }}\" > /dev/null 2>&1;
            do echo 'Retrying in 5 seconds...'; sleep 5; done" || ACCESS_FAILED=1

        - docker logs ${CI_JOB_NAME}-${CI_JOB_ID} > flask_log.txt
        - |
            if [ "$ACCESS_FAILED" = "1" ]; then
                echo "Failed to access App"
                docker stop ${CI_JOB_NAME}-${CI_JOB_ID} || true
                exit 1
            fi

        - >
            uv run pytest {{ project.ci.e2e_target }} --no-cov
            --host ${DOCKER_GATEWAY} --port ${APP_PORT}
            --junit-xml=reports/e2e-junit.xml

        - docker logs ${CI_JOB_NAME}-${CI_JOB_ID} > flask_log.txt
        - docker stop ${CI_JOB_NAME}-${CI_JOB_ID}

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          paths:
              - ${UV_CACHE_DIR}
        - key: playwright-${CI_PROJECT_ID}
          paths:
              - .cache/ms-playwright/

    artifacts:
        when: always
        paths:
            - flask_log.txt
            - reports/**
        reports:
            junit: reports/e2e-junit.xml
{%- endif %}

tag-latest:
    stage: tag-latest

    needs:
        - generate-tag
        # NOTE: docker ベースのテストジョブが無い構成では、build-image を明示的に
        # 待たないとイメージ push 前に実行されてしまう
        - job: build-image
          artifacts: false
        - job: test-typecheck
          artifacts: false
        - job: test-pytest
          artifacts: false
{%- if project.ci.webui_run %}
        - job: test-webui
          artifacts: false
{%- endif %}
{%- for job in project.ci.extra_test_jobs %}
        - job: {{ job }}
          artifacts: false
{%- endfor %}

    script:
{%- if "," in project.ci.build_platforms %}
        # NOTE: マルチアーキイメージは manifest ごと参照を張る必要がある
        - 'echo "Tagging multi-arch image ${CI_REGISTRY_IMAGE}:${TAG} as latest"'
        - docker buildx imagetools create -t ${CI_REGISTRY_IMAGE}:latest ${CI_REGISTRY_IMAGE}:${TAG}
{%- else %}
        - 'echo "Tagging ${CI_REGISTRY_IMAGE}:${TAG} as latest"'
        - docker pull ${CI_REGISTRY_IMAGE}:${TAG}
        - docker tag ${CI_REGISTRY_IMAGE}:${TAG} ${CI_REGISTRY_IMAGE}:latest
        - docker push ${CI_REGISTRY_IMAGE}:latest
{%- endif %}

    rules:
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - when: on_success

deploy:
    stage: deploy

    needs:
        - generate-tag
        # NOTE: docker ベースのテストジョブが無い構成では、build-image を明示的に
        # 待たないとイメージ push 前に実行されてしまう
        - job: build-image
          artifacts: false
        - job: test-typecheck
          artifacts: false
        - job: test-pytest
          artifacts: false
{%- if project.ci.webui_run %}
        - job: test-webui
          artifacts: false
{%- endif %}
{%- for job in project.ci.extra_test_jobs %}
        - job: {{ job }}
          artifacts: false
{%- endfor %}

    image:
        name: {{ vars.registry }}/local-kubectl:{{ vars.kubectl_tag }}

    before_script: []

    script:
        - 'IMAGE="${CI_REGISTRY_IMAGE}:${TAG}"'
        - 'echo "Deploying image: $IMAGE"'

        - kubectl config get-contexts
{% for line in project.ci.deploy_script %}
{%- if "\n" in line %}
        - >
{{ line | indent(12, true) }}
{%- else %}
        - {{ line }}
{%- endif %}
{%- endfor %}

        - 'echo "✓ All deployments updated successfully to $TAG"'

    rules:
        # NOTE: 自動実行ではデプロイしない
        - if: $CI_PIPELINE_SOURCE == "schedule"
          when: never
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - when: on_success

renovate:
    stage: renovate
    dependencies: []
    resource_group: renovate
    image:
        name: {{ vars.registry }}/local-renovate:{{ vars.renovate_tag }}

    before_script: []

    variables:
        RENOVATE_CACHE_DIR: .renovate-cache
        LOG_LEVEL: info

    script:
        - renovate --platform gitlab --token ${RENOVATE_TOKEN} --endpoint ${CI_SERVER_URL}/api/v4 ${CI_PROJECT_PATH}

    cache:
        key: renovate-${CI_PROJECT_ID}
        paths:
            - ${RENOVATE_CACHE_DIR}

    rules:
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - if: $CI_PIPELINE_SOURCE == "schedule"
        - changes:
              - renovate.json
{%- if project.ci.include_local %}

# プロジェクト固有ジョブ（py-project は触らない）
include:
    - local: .gitlab/ci-local.yml
{%- endif %}
