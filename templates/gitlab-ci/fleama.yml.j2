image: {{ vars.registry }}/local-ubuntu:{{ vars.ubuntu_tag }}

variables:
    UV_LINK_MODE: copy
    UV_CACHE_DIR: .uv-cache
    PYRIGHT_PYTHON_FORCE_VERSION: latest
    PLAYWRIGHT_BROWSERS_PATH: .playwright-browsers

    UV_HTTP_TIMEOUT: "120"
    UV_EXTRA_INDEX_URL: "http://proxy:3141/simple/"
    UV_INSECURE_HOST: "proxy"

default:
    before_script:
        - echo $CI_REGISTRY_PASSWORD | docker login -u $CI_REGISTRY_USER --password-stdin $CI_REGISTRY

stages:
    - generate-tag
    - build
    - test
    - tag-latest
    - deploy
    - renovate

generate-tag:
    stage: generate-tag
    script:
        # NOTE: タグはイメージ内容を決める入力 (アプリ + bot-config) から決定論的に生成する。
        # 日時部分は入力の最終コミット日時 (人間向け)、末尾の入力ハッシュが一意性を担保する。
        # 内容が変わらない限りタグは同一になり、変わったら必ずタグも変わるため、
        # 設定だけの変更でも kubectl set image が確実にロールアウトする。
        - |
            INPUT_SHAS="${CI_COMMIT_SHA}"
            NEWEST_EPOCH=$(date -d "${CI_COMMIT_TIMESTAMP}" +%s)
            git clone --quiet --depth 1 https://gitlab-ci-token:${CI_JOB_TOKEN}@gitlab.green-rabbit.net/kimata/bot-config.git .input-repo-1
            INPUT_SHAS="${INPUT_SHAS} $(git -C .input-repo-1 rev-parse HEAD)"
            REPO_EPOCH=$(git -C .input-repo-1 log -1 --format=%ct)
            if [ "${REPO_EPOCH}" -gt "${NEWEST_EPOCH}" ]; then NEWEST_EPOCH="${REPO_EPOCH}"; fi
            rm -rf .input-repo-1
            INPUT_HASH=$(echo "${INPUT_SHAS}" | sha1sum | cut -c1-7)
            echo "TAG=$(date -d "@${NEWEST_EPOCH}" +%y%m%d-%H%M)_${CI_COMMIT_SHORT_SHA}_i${INPUT_HASH}" > tag.env
            echo "IMAGE_BUILD_DATE=$(date -d "@${NEWEST_EPOCH}" --iso-8601=seconds)" >> tag.env
            cat tag.env
    artifacts:
        reports:
            dotenv: tag.env
        expire_in: 1 hour

build-react:
    stage: build

    needs: []

    image: {{ vars.ci_node_image }}

    variables:
        # @kimata スコープ (GitLab npm registry) の TLS 検証用 LAN CA
        NODE_EXTRA_CA_CERTS: ${CI_PROJECT_DIR}/frontend/.gitlab-ca.pem
        # NOTE: vite 等がバンドルに埋め込むビルド日時を決定論的にする
        # (wall-clock だと内容が変わらなくてもイメージが毎ビルド変化してしまう)
        IMAGE_BUILD_DATE: ${CI_COMMIT_TIMESTAMP}

    before_script: []

    script:
        - cd frontend
        - npm ci --cache .npm --prefer-offline --no-audit --no-fund
        - npm run {{ vars.ci_npm_build_script }}
    artifacts:
        paths:
            - frontend/dist/
    cache:
        - key:
              files:
                  - frontend/package-lock.json
          fallback_keys:
              - npm-cache-${CI_PROJECT_ID}
          paths:
              - .npm/

build-image:
    stage: build

    needs:
        - generate-tag
        - build-react

    variables:
        BUILDER: builder

    script:
        - 'echo "Building: ${CI_REGISTRY_IMAGE}:${TAG}"'
        - git clone https://gitlab-ci-token:${CI_JOB_TOKEN}@gitlab.green-rabbit.net/kimata/bot-config.git
        - mv bot-config/{{ project.get_app_name() }}.yaml config.yaml

        - docker buildx create --driver docker-container --name ${BUILDER} --use --config /etc/buildkitd.toml
        - docker buildx use ${BUILDER}
        - docker buildx inspect --bootstrap
        - >
            docker buildx build
            --provenance=false
            --progress=plain
            --platform linux/amd64
            --cache-from type=registry,ref=${CI_REGISTRY_IMAGE}:cache
            --cache-from type=registry,ref=${CI_REGISTRY_IMAGE}:latest
            --cache-to type=inline
            --cache-to type=registry,ref=${CI_REGISTRY_IMAGE}:cache,mode=max
            --build-arg IMAGE_BUILD_DATE=${IMAGE_BUILD_DATE}
            --tag ${CI_REGISTRY_IMAGE}:${TAG}
            --push .

    artifacts:
        paths:
            - config.yaml

test-typecheck:
    stage: test

    needs: []

    before_script:
        - uv sync --frozen --no-editable

    script:
        - uv run python -m pyright
        - uv run mypy src/
        - uv run ty check src/

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          policy: pull
          paths:
              - ${UV_CACHE_DIR}
              - .mypy_cache/

test-pytest:
    stage: test

    needs: []

    before_script:
        - uv sync --frozen --no-editable

    script:
        - uv run pytest

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          policy: pull
          paths:
              - ${UV_CACHE_DIR}

    artifacts:
        when: always
        paths:
            - data/debug/**
            - reports/**
        reports:
            junit: reports/junit-report.xml

test-docker:
    stage: test

    needs:
        - generate-tag
        - build-image

    script:
        - 'echo "Testing: ${CI_REGISTRY_IMAGE}:${TAG}"'
        - docker pull ${CI_REGISTRY_IMAGE}:${TAG}
        - mkdir -p data/debug
        # デバッグモードで実行（各ストア1アイテムのみチェックして終了）
        # uv run 経由で実行する（パッケージは .venv にインストールされているため）
        - docker run --rm -v $(pwd)/data/debug:/opt/{{ project.get_app_name() }}/data/debug ${CI_REGISTRY_IMAGE}:${TAG} uv run --no-group dev {{ project.get_app_name() }} -D

    artifacts:
        when: on_failure
        paths:
            - data/debug/**

test-webui:
    stage: test
    needs:
        - generate-tag
        - build-image

    script:
        # NOTE: テストに失敗するとテスト用のコンテナが残るので削除する
        - >
            docker ps --filter "label=job=${CI_JOB_NAME}" | grep hours |
            cut -d " " -f1 |
            while read id; do docker stop -t 5 $id; done || true

        # テスト用のダミー価格履歴DBを作成
        - uv sync --frozen --no-editable
        - mkdir -p test_data
        - uv run python scripts/create_test_price_db.py -o test_data/{{ vars.ci_test_db_file }}

        # コンテナを起動（SSR: port 3000）
        # sleep infinity で起動し、DBコピー後に supervisord を起動
        - >
            docker run --rm --detach=true --tty=true
            --name ${CI_JOB_NAME}-${CI_JOB_ID} --label job=${CI_JOB_NAME}
            --publish :3000
            --env PRICE_PLATFORM_ALLOW_LOCAL_ORIGIN=1
            ${CI_REGISTRY_IMAGE}:${TAG} sleep infinity

        # docker cp でDBファイルをコピー（ubuntuユーザーで書き込み）
        - docker exec -u ubuntu ${CI_JOB_NAME}-${CI_JOB_ID} mkdir -p /opt/{{ project.get_app_name() }}/data
        - docker exec -i -u ubuntu ${CI_JOB_NAME}-${CI_JOB_ID} sh -c "cat > /opt/{{ project.get_app_name() }}/data/{{ vars.ci_test_db_file }}" < test_data/{{ vars.ci_test_db_file }}

        # docker-entrypoint.sh 経由で起動（SSR_INTERNAL_SECRET を自動生成してから supervisord を起動）
        - docker exec --detach ${CI_JOB_NAME}-${CI_JOB_ID} /opt/{{ project.get_app_name() }}/docker-entrypoint.sh

        - uv run playwright install --with-deps chromium

        - >
            APP_PORT=$(docker port "${CI_JOB_NAME}-${CI_JOB_ID}" 3000 | cut -d: -f2)
        - >
            DOCKER_GATEWAY=$(docker network inspect bridge --format="{% raw %}{{range .IPAM.Config}}{{.Gateway}}{{end}}{% endraw %}")
        - >
            timeout 60 bash -c "until curl --fail --connect-timeout 10 --max-time 15
            \"http://${DOCKER_GATEWAY}:${APP_PORT}/\" > /dev/null 2>&1;
            do echo 'Retrying in 5 seconds...'; sleep 5; done" || ACCESS_FAILED=1

        - docker logs ${CI_JOB_NAME}-${CI_JOB_ID} > flask_log.txt
        - |
            if [ "$ACCESS_FAILED" = "1" ]; then
                echo "Failed to access App"
                docker stop ${CI_JOB_NAME}-${CI_JOB_ID} || true
                exit 1
            fi

        - >
            uv run pytest tests/e2e/test_webui.py --no-cov
            --host ${DOCKER_GATEWAY} --port ${APP_PORT}
            --junit-xml=reports/e2e-junit.xml

        - docker logs ${CI_JOB_NAME}-${CI_JOB_ID} > flask_log.txt
        - docker stop ${CI_JOB_NAME}-${CI_JOB_ID}

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          policy: pull
          paths:
              - ${UV_CACHE_DIR}
        - key: playwright-${CI_PROJECT_ID}
          policy: pull
          paths:
              - ${PLAYWRIGHT_BROWSERS_PATH}

    artifacts:
        when: always
        paths:
            - flask_log.txt
            - reports/**
        reports:
            junit: reports/e2e-junit.xml

tag-latest:
    stage: tag-latest

    needs:
        - generate-tag
        - job: test-typecheck
          artifacts: false
        - job: test-pytest
          artifacts: false
        - job: test-docker
          artifacts: false
        - job: test-webui
          artifacts: false

    script:
        - 'echo "Tagging ${CI_REGISTRY_IMAGE}:${TAG} as latest"'
        - docker pull ${CI_REGISTRY_IMAGE}:${TAG}
        - docker tag ${CI_REGISTRY_IMAGE}:${TAG} ${CI_REGISTRY_IMAGE}:latest
        - docker push ${CI_REGISTRY_IMAGE}:latest

    rules:
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - when: on_success

deploy:
    stage: deploy

    needs:
        - generate-tag
        - job: test-typecheck
          artifacts: false
        - job: test-pytest
          artifacts: false
        - job: test-docker
          artifacts: false
        - job: test-webui
          artifacts: false

    image:
        name: gitlab.green-rabbit.net:5050/kimata/local-kubectl:250715_c88f3965

    before_script: []

    script:
        - 'IMAGE="${CI_REGISTRY_IMAGE}:${TAG}"'
        - 'echo "Deploying image: $IMAGE"'

        - kubectl config get-contexts
        - kubectl config use-context kimata/{{ project.get_app_name() }}:pod-rollout

        - kubectl -n bot set image deployment/{{ project.get_app_name() }} {{ project.get_app_name() }}=${IMAGE}
        - kubectl -n bot rollout status deployment/{{ project.get_app_name() }} --timeout=300s

        - 'echo "All deployments updated successfully to $TAG"'

    rules:
        # NOTE: 自動実行ではデプロイしない
        - if: $CI_PIPELINE_SOURCE == "schedule"
          when: never
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - when: on_success

update-cache:
    stage: renovate

    needs: []

    before_script:
        - uv sync --frozen --no-editable

    script:
        - uv run playwright install --with-deps chromium
        - echo "Cache updated"

    cache:
        - key:
              files:
                  - uv.lock
          fallback_keys:
              - uv-cache-${CI_PROJECT_ID}
          paths:
              - ${UV_CACHE_DIR}
        - key: playwright-${CI_PROJECT_ID}
          paths:
              - ${PLAYWRIGHT_BROWSERS_PATH}

    rules:
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - if: $CI_PIPELINE_SOURCE == "schedule"

renovate:
    stage: renovate
    dependencies: []
    resource_group: renovate
    image:
        name: {{ vars.registry }}/local-renovate:{{ vars.renovate_tag }}

    before_script: []

    variables:
        RENOVATE_CACHE_DIR: .renovate-cache
        LOG_LEVEL: info

    script:
        - renovate --platform gitlab --token ${RENOVATE_TOKEN} --endpoint ${CI_SERVER_URL}/api/v4 ${CI_PROJECT_PATH}

    cache:
        key: renovate-${CI_PROJECT_ID}
        paths:
            - ${RENOVATE_CACHE_DIR}

    rules:
        - if: $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
          when: never
        - if: $CI_PIPELINE_SOURCE == "schedule"
        - if: $CI_PIPELINE_SOURCE == "push"
          changes:
              - renovate.json
