{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "py-project Configuration",
  "description": "複数Pythonプロジェクトへの設定適用ツールの設定ファイル",
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "defaults": {
      "type": "object",
      "description": "全プロジェクト共通のデフォルト設定",
      "properties": {
        "python_version": {
          "type": "string",
          "description": "デフォルトの Python バージョン",
          "pattern": "^3\\.[0-9]+$",
          "default": "3.12"
        },
        "configs": {
          "type": "array",
          "description": "デフォルトで適用する設定タイプ",
          "items": {
            "$ref": "#/$defs/configType"
          },
          "default": []
        },
        "vars": {
          "type": "object",
          "description": "テンプレート変数（Jinja2 で展開）",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gitlab_ci": {
          "$ref": "#/$defs/gitlabCiOptions"
        }
      },
      "additionalProperties": false
    },
    "template_dir": {
      "type": "string",
      "description": "テンプレートディレクトリのパス",
      "default": "./templates"
    },
    "projects": {
      "type": "array",
      "description": "管理対象プロジェクト一覧",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "configType": {
      "type": "string",
      "enum": [
        "pre-commit",
        "ruff",
        "yamllint",
        "prettier",
        "python-version",
        "dockerignore",
        "gitignore",
        "renovate",
        "license",
        "pyproject",
        "my-py-lib",
        "gitlab-ci",
        "dockerfile",
        "supervisord",
        "docker-entrypoint",
        "gitlab-ci-gen"
      ],
      "description": "設定タイプ"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "プロジェクト名（識別用）",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "description": "プロジェクトのパス（絶対パスまたは ~/ 形式）",
          "minLength": 1
        },
        "configs": {
          "type": "array",
          "description": "追加で適用する設定タイプ（defaults.configs にマージ）",
          "items": {
            "$ref": "#/$defs/configType"
          }
        },
        "exclude_configs": {
          "type": "array",
          "description": "除外する設定タイプ（defaults.configs から除外）",
          "items": {
            "$ref": "#/$defs/configType"
          }
        },
        "vars": {
          "type": "object",
          "description": "テンプレート変数",
          "properties": {
            "python_version": {
              "type": "string",
              "pattern": "^3\\.[0-9]+$"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "template_overrides": {
          "type": "object",
          "description": "設定タイプ別のテンプレート上書き",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pyproject": {
          "type": "object",
          "description": "pyproject.toml 設定タイプのオプション",
          "properties": {
            "preserve_sections": {
              "type": "array",
              "description": "追加で保持するセクション",
              "items": {
                "type": "string"
              }
            },
            "preserve_fields": {
              "type": "array",
              "description": "[project] セクション内で追加で保持するフィールド（例: requires-python）",
              "items": {
                "type": "string"
              }
            },
            "extra_dev_deps": {
              "type": "array",
              "description": "追加の開発依存",
              "items": {
                "type": "string"
              }
            },
            "pytest_cov_target": {
              "type": "string",
              "description": "pytest のカバレッジ計測対象（addopts の --cov=src を置き換える）"
            }
          },
          "additionalProperties": false
        },
        "gitlab_ci": {
          "$ref": "#/$defs/gitlabCiOptions"
        },
        "gitignore": {
          "$ref": "#/$defs/gitignoreOptions"
        },
        "dockerignore": {
          "$ref": "#/$defs/dockerignoreOptions"
        },
        "ruff": {
          "$ref": "#/$defs/ruffOptions"
        },
        "license": {
          "$ref": "#/$defs/licenseOptions"
        },
        "docker": {
          "$ref": "#/$defs/dockerOptions"
        },
        "ci": {
          "$ref": "#/$defs/ciOptions"
        }
      },
      "additionalProperties": false
    },
    "gitignoreOptions": {
      "type": "object",
      "description": "gitignore 設定タイプのオプション",
      "properties": {
        "extra_lines": {
          "type": "array",
          "description": "テンプレートの末尾に追加する行（例: !config.yaml）",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dockerignoreOptions": {
      "type": "object",
      "description": "dockerignore 設定タイプのオプション",
      "properties": {
        "extra_lines": {
          "type": "array",
          "description": "テンプレートの末尾に追加する行",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dockerOptions": {
      "type": "object",
      "description": "dockerfile 設定タイプのオプション",
      "properties": {
        "template": {
          "type": "string",
          "description": "Dockerfile テンプレート名",
          "enum": [
            "standard",
            "supervisor",
            "hardware"
          ]
        },
        "app_name": {
          "type": "string",
          "description": "WORKDIR (/opt/<app_name>) に使う名前。省略時はプロジェクト名"
        },
        "chrome": {
          "type": "boolean",
          "description": "Google Chrome をインストールするか"
        },
        "chrome_version": {
          "type": "string",
          "description": "Chrome のバージョンを固定する場合に指定（例: 142.0.7444.175-1）"
        },
        "fonts": {
          "type": "boolean",
          "description": "リポジトリの font/ をイメージへコピーするか"
        },
        "cjk_fonts": {
          "type": "boolean",
          "description": "fonts-noto-cjk を apt でインストールするか",
          "default": true
        },
        "extra_apt": {
          "type": "array",
          "description": "追加でインストールする apt パッケージ",
          "items": {
            "type": "string"
          }
        },
        "extra_mkdir": {
          "type": "array",
          "description": "追加で作成するディレクトリ（named volume の所有権対策等）",
          "items": {
            "type": "string"
          }
        },
        "expose": {
          "type": "array",
          "description": "EXPOSE するポート",
          "items": {
            "type": "integer"
          }
        },
        "cmd": {
          "type": "array",
          "description": "CMD に設定するコマンド",
          "items": {
            "type": "string"
          }
        },
        "install_project": {
          "type": "boolean",
          "description": "COPY 後にプロジェクト自身を uv sync でインストールするか",
          "default": true
        },
        "compile_bytecode": {
          "type": "boolean",
          "description": "uv sync に --compile-bytecode を付けるか"
        },
        "python_version": {
          "type": "string",
          "description": "hardware テンプレートの Python バージョン",
          "default": "3.13"
        },
        "lgpio": {
          "type": "boolean",
          "description": "lgpio ライブラリをビルドしてコピーするか (Raspberry Pi GPIO)"
        },
        "dev_deps": {
          "type": "boolean",
          "description": "dev グループの依存もインストールするか (time-machine API 等)"
        },
        "extra_env": {
          "type": "object",
          "description": "追加の ENV",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ruffOptions": {
      "type": "object",
      "description": "ruff 設定タイプのオプション",
      "properties": {
        "extra_lines": {
          "type": "array",
          "description": "テンプレートの末尾に追加する行（プロジェクト固有の TOML セクション等）",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "licenseOptions": {
      "type": "object",
      "description": "license 設定タイプのオプション",
      "properties": {
        "type": {
          "type": "string",
          "description": "ライセンスタイプ（テンプレートファイル名と一致、例: Apache-2.0, MIT）",
          "default": "Apache-2.0"
        }
      },
      "additionalProperties": false
    },
    "gitlabCiOptions": {
      "type": "object",
      "description": "gitlab-ci 設定タイプのオプション",
      "properties": {
        "edits": {
          "type": "array",
          "description": "yamlpath 形式で値を編集",
          "items": {
            "type": "object",
            "required": [
              "path",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "yamlpath 形式のパス（例: /image, /renovate/image/name）"
              },
              "value": {
                "type": "string",
                "description": "設定する値"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ciOptions": {
      "type": "object",
      "description": "gitlab-ci-gen 設定タイプのオプション",
      "properties": {
        "template": {
          "type": "string",
          "description": ".gitlab-ci.yml テンプレート名",
          "enum": [
            "fleama",
            "library",
            "docker"
          ]
        },
        "ty": {
          "type": "boolean",
          "description": "typecheck に ty check を含めるか",
          "default": true
        },
        "pyright_target": {
          "type": "string",
          "description": "pyright の対象引数（空なら引数なし）",
          "default": "src/"
        },
        "pytest_args": {
          "type": "string",
          "description": "pytest の追加引数"
        },
        "pytest_pre": {
          "type": "array",
          "description": "pytest 前に実行する追加コマンド",
          "items": {
            "type": "string"
          }
        },
        "pytest_env_ja": {
          "type": "boolean",
          "description": "日本語ロケール env を export するか"
        },
        "extra_artifacts": {
          "type": "array",
          "description": "test-pytest の追加 artifact パス",
          "items": {
            "type": "string"
          }
        },
        "smoke_config": {
          "type": "string",
          "description": "test-smoke の bot-config 設定ファイル名"
        },
        "smoke_command": {
          "type": "string",
          "description": "test-smoke の実行コマンド名"
        },
        "lint": {
          "type": "boolean",
          "description": "ruff の test-lint ジョブを含めるか"
        },
        "update_cache": {
          "type": "boolean",
          "description": "update-cache ジョブを含めるか"
        },
        "frontend": {
          "type": "boolean",
          "description": "build-react ジョブを含めるか",
          "default": true
        },
        "npm_build_script": {
          "type": "string",
          "description": "frontend の npm run スクリプト名",
          "default": "build"
        },
        "config_script": {
          "type": "array",
          "description": "設定ファイル取得のスクリプト行 (build-image / test-pytest で共用)",
          "items": {
            "type": "string"
          }
        },
        "pytest_config_script": {
          "type": "boolean",
          "description": "test-pytest でも config_script を実行するか",
          "default": true
        },
        "webui_run": {
          "type": "array",
          "description": "test-webui でアプリを起動するスクリプト行",
          "items": {
            "type": "string"
          }
        },
        "webui_health_path": {
          "type": "string",
          "description": "test-webui のヘルスチェックパス"
        },
        "e2e_target": {
          "type": "string",
          "description": "E2E テストの対象",
          "default": "tests/e2e/test_webui.py"
        },
        "deploy_script": {
          "type": "array",
          "description": "deploy の kubectl スクリプト行",
          "items": {
            "type": "string"
          }
        },
        "include_local": {
          "type": "boolean",
          "description": ".gitlab/ci-local.yml を include するか"
        },
        "extra_test_jobs": {
          "type": "array",
          "description": "tag-latest / deploy の needs に追加するプロジェクト固有テストジョブ (ci-local.yml 側で定義)",
          "items": {
            "type": "string"
          }
        },
        "extra_build_args": {
          "type": "array",
          "description": "docker buildx build に追加する --build-arg 等の引数",
          "items": {
            "type": "string"
          }
        },
        "build_platforms": {
          "type": "string",
          "description": "docker buildx build の --platform 指定",
          "default": "linux/amd64"
        },
        "typecheck_allow_failure": {
          "type": "boolean",
          "description": "test-typecheck に allow_failure を付けるか (型チェック未整備プロジェクトの段階導入用)"
        },
        "typecheck_target": {
          "type": "string",
          "description": "mypy / ty の対象ディレクトリ",
          "default": "src/"
        },
        "extra_build_needs": {
          "type": "array",
          "description": "build-image の needs に追加するジョブ (ci-local.yml 側で定義したビルドジョブ等)",
          "items": {
            "type": "string"
          }
        },
        "test_needs": {
          "type": "array",
          "description": "test-typecheck / test-pytest の needs (省略時は依存なし)",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
